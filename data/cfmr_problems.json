{
 "meta": {
  "schema_version": 2,
  "dataset": "CFMR",
  "n_problems": 90,
  "description": "90-problem CUTEst test set for derivative-free optimization: 60 nonlinear least-squares problems (CR) + 30 general-objective problems (EXT). Third-party transcription; see attribution.",
  "objective_conventions": {
   "sum_of_squares": "f_x0_expected and f_star_expected are ||r(x)||^2 = sum_i r_i(x)^2. This is what Cartis & Roberts (2019) Table 3 tabulates in its '2f(x0)' and '2f*' columns, because that paper defines f = 0.5*||r||^2. Values are stored exactly as printed there so a row can be checked against the paper by eye; a solver that minimises 0.5*||r||^2 reports half of them (see cfmr.rescale).",
   "as_published": "f_x0_expected and f_star_expected are the objective f(x) exactly as tabulated in the source paper, with no factor."
  },
  "convergence_test": "More & Wild (2009): problem solved at budget k if f(x0) - f(x_k) >= (1 - tau) * (f(x0) - f_L), with f_L = f_star_expected. The test is invariant to a positive rescaling of f, so a convention may differ between entries, but f(x0), f(x_k) and f_L must share one convention within an entry.",
  "budget": "budget = budget_scale * (n + 1) evaluations, i.e. budget_scale simplex gradients. budget_scale is stored per problem; read it, do not assume it.",
  "verify_tol_rel": 0.001,
  "fields": {
   "name": "SIF problem name as the paper writes it; authoritative.",
   "name_alt": "Names the same problem may carry in other MASTSIF versions, tried in order when `name` does not resolve. Empty for most entries.",
   "sif_params": "SIF parameters reproducing the paper's dimensions.",
   "sif_params_alt": "Candidate parameter dicts tried in order; the papers sometimes state a dimension ('N/2 = 50') rather than a SIF key.",
   "m": "Residual length for CR entries; null for EXT.",
   "objective_convention": "Units of f_x0_expected and f_star_expected. Redundant with is_nls by construction, and stated anyway: is_nls describes the problem, this describes these two numbers."
  },
  "sources": [
   "C. Cartis and L. Roberts, 'A derivative-free Gauss-Newton method', Mathematical Programming Computation, 11(4), pp. 631-674, 2019. (CR problems, Table 3)",
   "C. Cartis, J. Fiala, B. Marteau and L. Roberts, 'Improving the flexibility and robustness of model-based derivative-free optimization solvers', ACM Transactions on Mathematical Software, 45(3), pp. 1-41, 2019. (EXT problems)"
  ]
 },
